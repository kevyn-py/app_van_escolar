rules_version = '2';

// Regras de segurança — Controle de Embarque e Desembarque Escolar (RNF-05).
// - Bloqueio padrão de todo o banco.
// - Cada operador acessa apenas a própria árvore users/{uid}.
// - Validação de estrutura mínima, status e perfis.
// - Registros de dias anteriores são imutáveis e nunca podem ser apagados (RN-09).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validRouteProfile(p) {
      return p in ['ida_e_volta', 'somente_ida', 'somente_volta'];
    }

    function validStatus(s) {
      return s in ['pendente', 'confirmado', 'nao_compareceu', 'nao_se_aplica'];
    }

    // ---------- Operador ----------
    function validUser(d) {
      return d.keys().hasAll(['displayName', 'email', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['displayName', 'email', 'preferences', 'createdAt', 'updatedAt'])
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 80
        && d.email is string && d.email.size() <= 254
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && (!('preferences' in d) || (
              d.preferences is map
              && d.preferences.keys().hasOnly(['defaultEventSort'])
              && (!('defaultEventSort' in d.preferences)
                  || d.preferences.defaultEventSort in ['pending_first', 'alphabetical'])));
    }

    // ---------- Aluno (cadastro mínimo, sem fotos — LGPD) ----------
    function validStudent(d) {
      return d.keys().hasAll(['name', 'active', 'avatarIcon', 'avatarColor', 'routeProfile', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'active', 'avatarIcon', 'avatarColor', 'routeProfile', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.active is bool
        && d.avatarIcon is string && d.avatarIcon.size() >= 1 && d.avatarIcon.size() <= 30
        && d.avatarColor is string && d.avatarColor.size() >= 1 && d.avatarColor.size() <= 30
        && validRouteProfile(d.routeProfile)
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    // ---------- Registro diário ----------
    function validDateKey(k) {
      return k.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function dayStart(k) {
      return timestamp.date(int(k[0:4]), int(k[5:7]), int(k[8:10]));
    }

    // Aceita escrita apenas na janela do próprio dia, com tolerância de fuso horário
    // (UTC-12 a UTC+14). O bloqueio exato pela data local é feito também no frontend.
    function writableDate(k) {
      return validDateKey(k)
        && request.time > dayStart(k) - duration.value(14, 'h')
        && request.time < dayStart(k) + duration.value(36, 'h');
    }

    function validEvent(e) {
      return e is map
        && e.keys().hasAll(['status', 'updatedAt'])
        && e.keys().hasOnly(['status', 'updatedAt'])
        && validStatus(e.status)
        && (e.updatedAt == null || e.updatedAt is timestamp);
    }

    function validEntry(e, sid) {
      return e is map
        && e.keys().hasAll(['studentId', 'nameSnapshot', 'avatarIconSnapshot', 'avatarColorSnapshot', 'routeProfileSnapshot', 'events'])
        && e.keys().hasOnly(['studentId', 'nameSnapshot', 'avatarIconSnapshot', 'avatarColorSnapshot', 'routeProfileSnapshot', 'removed', 'events'])
        && e.studentId == sid
        && e.nameSnapshot is string && e.nameSnapshot.size() <= 80
        && e.avatarIconSnapshot is string && e.avatarColorSnapshot is string
        && validRouteProfile(e.routeProfileSnapshot)
        && (!('removed' in e) || e.removed is bool)
        && e.events is map
        && e.events.keys().hasAll(['embarque_escola', 'desembarque_escola', 'embarque_casa', 'desembarque_casa'])
        && e.events.keys().hasOnly(['embarque_escola', 'desembarque_escola', 'embarque_casa', 'desembarque_casa'])
        && validEvent(e.events.embarque_escola)
        && validEvent(e.events.desembarque_escola)
        && validEvent(e.events.embarque_casa)
        && validEvent(e.events.desembarque_casa);
    }

    function validDay(d, k) {
      return d.keys().hasAll(['date', 'studentCount', 'summary', 'students', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['date', 'studentCount', 'summary', 'students', 'lastChangedStudentId', 'createdAt', 'updatedAt'])
        && d.date == k
        && d.summary is map
        && d.students is map && d.students.size() <= 200
        && d.studentCount is int && d.studentCount == d.students.size()
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    // Cada atualização altera no máximo UM aluno, identificado em lastChangedStudentId,
    // cuja entrada (se ainda existir) é validada por completo — inclusive os 4 status.
    function validDayUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let sid = after.lastChangedStudentId;
      return after.date == before.date
        && after.createdAt == before.createdAt
        && sid is string
        && after.students.diff(before.students).affectedKeys().hasOnly([sid])
        && (!(sid in after.students) || validEntry(after.students[sid], sid));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data);
      allow delete: if false;

      match /students/{studentId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validStudent(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /dailyRecords/{dateKey} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && writableDate(dateKey)
          && validDay(request.resource.data, dateKey)
          && request.resource.data.lastChangedStudentId == null;
        allow update: if isOwner(uid)
          && writableDate(dateKey)
          && validDay(request.resource.data, dateKey)
          && validDayUpdate();
        allow delete: if false;
      }
    }

    // Bloqueio padrão para qualquer outro caminho.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
